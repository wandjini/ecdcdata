						"renamingDailyFields sort(desc(reported_date, true),",
						"     asc(country, true)) ~> sortDaily",
						"sortWeeklyData sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          country as string,",
						"          country_code as string,",
