{
	"name": "df_transform_testing",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_testing_data_sa",
						"type": "DatasetReference"
					},
					"name": "testingDataSource"
				},
				{
					"dataset": {
						"referenceName": "ds_lookup_country",
						"type": "DatasetReference"
					},
					"name": "countryDataSource"
				},
				{
					"dataset": {
						"referenceName": "ds_dim_date",
						"type": "DatasetReference"
					},
					"name": "dateDimDataSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_processed_testing_data",
						"type": "DatasetReference"
					},
					"name": "testingDataSink"
				}
			],
			"transformations": [
				{
					"name": "lookupCountry"
				},
				{
					"name": "selectRequiredFields"
				},
				{
					"name": "joinWithDimDate"
				},
				{
					"name": "aggregateDimDate"
				},
				{
					"name": "getFinalFields"
				}
			],
			"scriptLines": [
				"source(output(",
				"          country as string,",
				"          country_code as string,",
				"          year_week as string,",
				"          new_cases as string,",
				"          tests_done as string,",
				"          population as string,",
				"          testing_rate as string,",
				"          positivity_rate as string,",
				"          testing_data_source as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> testingDataSource",
				"source(output(",
				"          country as string,",
				"          country_code_2_digit as string,",
				"          country_code_3_digit as string,",
				"          continent as string,",
				"          population as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> countryDataSource",
				"source(output(",
				"          date_key as string,",
				"          date as string,",
				"          year as string,",
				"          month as string,",
				"          day as string,",
				"          day_name as string,",
				"          day_of_year as string,",
				"          week_of_month as string,",
				"          week_of_year as string,",
				"          month_name as string,",
				"          year_month as string,",
				"          year_week as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dateDimDataSource",
				"testingDataSource, countryDataSource lookup(testingDataSource@country == countryDataSource@country,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupCountry",
				"lookupCountry select(mapColumn(",
				"          country = testingDataSource@country,",
				"          country_code,",
				"          year_week,",
				"          country = countryDataSource@country,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          new_cases,",
				"          tests_done,",
				"          population = testingDataSource@population,",
				"          testing_rate,",
				"          positivity_rate,",
				"          testing_data_source",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectRequiredFields",
				"selectRequiredFields, aggregateDimDate join(selectRequiredFields@year_week == aggregateDimDate@year_week,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinWithDimDate",
				"dateDimDataSource aggregate(groupBy(year_week = year+'-W'+lpad(week_of_year,2,'0')),",
				"     week_start_date = min(date),",
				"          week_end_date = max(date)) ~> aggregateDimDate",
				"joinWithDimDate select(mapColumn(",
				"          country,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          year_week = aggregateDimDate@year_week,",
				"          week_start_date,",
				"          week_end_date,",
				"          new_cases,",
				"          tests_done,",
				"          population,",
				"          testing_data_source,",
				"          testing_rate,",
				"          positivity_rate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> getFinalFields",
				"getFinalFields sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> testingDataSink"
			]
		}
	}
}